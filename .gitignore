# ============================================
# Murindi - Open Source Repository
# ============================================

# ========================
# Frontend
# ========================
# Frontend source lives in the private Murindi-Vue repo. The published
# `ghcr.io/<owner>/murindi-frontend` image is consumed via docker-compose
# by default. For local source iteration, clone Murindi-Vue into the
# `/Murindi-Vue/` slot below and run `docker compose up --build` — that
# path is referenced by docker-compose.yml's frontend `build.context`
# directive. Nothing under these paths should ever be committed here.
/murindi_vue/
/Murindi-Vue-src/
/Murindi-Vue/
/frontend/

# ========================
# Environment & Secrets
# ========================
.env
.env.local
.env.*.local
backend_api_python/.env

